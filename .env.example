# FastAPI Server Config
PORT=8000
DATABASE_URL=sqlite:///./translator.db

# Speech Recognition Model (Options: openai/whisper-tiny, openai/whisper-base, openai/whisper-medium, openai/whisper-large-v3)
WHISPER_MODEL_NAME=openai/whisper-tiny

# Machine Translation Model (Options: facebook/nllb-200-distilled-600M, facebook/nllb-200-distilled-1.3B)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# Frontend API URL
VITE_API_URL=http://localhost:8000
